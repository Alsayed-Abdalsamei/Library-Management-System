import os
import shutil
import winreg

def get_installed_programs():
    """ يستخرج قائمة البرامج المثبتة من سجل Windows """
    programs = set()
    reg_paths = [
        r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
        r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"
    ]
    
    for reg_path in reg_paths:
        try:
            with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, reg_path) as key:
                for i in range(0, winreg.QueryInfoKey(key)[0]):
                    try:
                        subkey_name = winreg.EnumKey(key, i)
                        with winreg.OpenKey(key, subkey_name) as subkey:
                            path, _ = winreg.QueryValueEx(subkey, "InstallLocation")
                            if path:
                                programs.add(path)
                    except FileNotFoundError:
                        continue
                    except OSError:
                        continue
        except FileNotFoundError:
            continue
    
    return programs

def clean_unused_paths(paths_to_check):
    """ يفحص المسارات ويحذف غير المستخدمة """
    installed_programs = get_installed_programs()
    
    for path in paths_to_check:
        if not os.path.exists(path) or path not in installed_programs:
            try:
                if os.path.isdir(path):
                    shutil.rmtree(path)  # حذف المجلد ومحتوياته
                else:
                    os.remove(path)  # حذف الملف
                print(f"تم حذف: {path}")
            except Exception as e:
                print(f"تعذر حذف {path}: {e}")
        else:
            print(f"مسار قيد الاستخدام: {path}")

if __name__ == "__main__":
    paths = [
        r"C:\Program Files\OldSoftware",
        r"C:\UnusedFolder",
        r"C:\ProgramData\SomeApp",
        r"C:\Temp\UnusedFile.txt"
    ]
    clean_unused_paths(paths)
